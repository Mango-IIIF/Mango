          "conformsTo": "http://www.w3.org/TR/media-frags/",
          "value": "xywh=1150,900,1100,800"
        }
      }
    },
    {
      "id": "http://localhost:5173/interop/gottingen-story.json/annotation/5",
      "type": "Annotation",
      "motivation": "commenting",
      "label": {
        "en": [
          "Half-timbered corner"
        ]
      },
      "body": {
        "type": "TextualBody",
        "value": "Across the square a timber-framed house turns the corner, its dark beams set against white render, dormer windows in a steep tiled roof, and a café sign at ground level.",
        "format": "text/plain",
        "language": "en",
        "purpose": "describing"
      },
