    {
      "id": "http://localhost:5173/interop/gottingen-story.json/annotation/6",
      "type": "Annotation",
      "motivation": "commenting",
      "label": {
        "en": [
          "The paving"
        ]
      },
      "body": {
        "type": "TextualBody",
        "value": "Most of the photograph is given over to the paving itself — grey and buff granite setts laid in broad bands, sweeping out towards the foreground and holding the whole square together.",
