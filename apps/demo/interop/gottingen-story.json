      "type": "Annotation",
      "motivation": "commenting",
      "label": {
        "en": [
          "The market square"
        ]
      },
      "body": {
        "type": "TextualBody",
        "value": "An August evening on the Markt in Göttingen, photographed during the 2019 IIIF Conference. The square is still warm, the café awnings are out, and the light is going.",
        "format": "text/plain",
        "language": "en",
        "purpose": "describing"
      },
      "target": {
        "type": "SpecificResource",
        "source": "https://iiif.io/api/cookbook/recipe/0005-image-service/canvas/p1",
        "partOf": [
          {
            "id": "https://iiif.io/api/cookbook/recipe/0005-image-service/manifest.json",
            "type": "Manifest"
          }
        ],
        "selector": {
